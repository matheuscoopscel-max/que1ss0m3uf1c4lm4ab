# FILE: backend/.env.example
# Copie para .env e preencha com seus valores reais.
# NUNCA commite .env no git.

# ── Servidor ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development            # development | production

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
# Formato completo (preferido em produção/Docker):
DATABASE_URL=postgresql://omnimedia:omnimedia_pass@localhost:5432/omnimedia_db

# Ou variáveis individuais (usadas se DATABASE_URL não estiver definida):
DB_HOST=localhost
DB_PORT=5432
DB_NAME=omnimedia_db
DB_USER=omnimedia
DB_PASSWORD=omnimedia_pass

# ── CORS ───────────────────────────────────────────────────────────────────────
# Origens permitidas separadas por vírgula (ex: http://localhost:5173,https://omnimedia.app)
CORS_ORIGINS=http://localhost:5173

# ── Rate Limiting ──────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000      # janela em ms (padrão: 1 minuto)
RATE_LIMIT_MAX=100              # requisições máximas por janela por IP
SUBMIT_RATE_LIMIT_MAX=5         # submissões de plugin por janela por IP

# ── JWT ────────────────────────────────────────────────────────────────────────
# Gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=your_access_secret_here_min_32_chars
JWT_REFRESH_SECRET=your_refresh_secret_here_min_32_chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ── Bcrypt ─────────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12

# ── Admin / Criptografia ───────────────────────────────────────────────────────
# Chave mestra para criptografia AES-256-GCM das API keys no banco.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# OBRIGATÓRIA em produção. Em dev, uma chave padrão é usada com aviso.
MASTER_KEY=your_64_hex_chars_here

# ── Logging ────────────────────────────────────────────────────────────────────
LOG_DIR=./logs
LOG_LEVEL=info

# ── Site ───────────────────────────────────────────────────────────────────────
SITE_NAME=OmniMedia
