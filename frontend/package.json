{
  "name": "omnimedia-frontend",
  "version": "1.0.0",
  "description": "OmniMedia Project — Unified Media Aggregator Frontend",
  "type": "module",
  "scripts": {
    "dev":             "vite",
    "build":           "vite build",
    "preview":         "vite preview",

    "build:desktop":   "npm run build && npx tauri build",
    "dev:desktop":     "npx tauri dev",

    "build:android":   "npm run build && npx cap sync android && npx cap build android",
    "build:tv":        "npm run build && npx cap sync android && npx cap build android --flavor tv",
    "dev:android":     "npx cap run android",

    "cap:sync":        "npx cap sync",
    "cap:open:android":"npx cap open android"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.4",
    "hls.js": "^1.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "@tauri-apps/cli": "^2.0.0",
    "@tauri-apps/api": "^2.0.0",
    "@capacitor/cli": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "@capacitor/android": "^6.1.2",
    "@capacitor/splash-screen": "^6.0.2",
    "@capacitor/status-bar": "^6.0.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.6",
    "vite": "^5.3.4"
  }
}
