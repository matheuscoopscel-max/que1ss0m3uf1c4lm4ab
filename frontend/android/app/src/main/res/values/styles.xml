<?xml version="1.0" encoding="utf-8"?>
<!-- FILE: frontend/android/app/src/main/res/values/styles.xml -->
<resources>
    <!-- Tema base escuro para o OmniMedia -->
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <!-- Fundo escuro #0a0a0f durante carregamento -->
        <item name="android:background">#0a0a0f</item>
        <item name="android:windowBackground">#0a0a0f</item>
        <item name="android:colorBackground">#0a0a0f</item>
        <item name="android:statusBarColor">#0a0a0f</item>
        <item name="android:navigationBarColor">#0a0a0f</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <!-- Remove barra de título nativa -->
        <item name="windowNoTitle">true</item>
        <item name="android:windowFullscreen">false</item>
    </style>
</resources>
